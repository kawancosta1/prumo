# Exemplo de configuração de variáveis de ambiente para Cloud Functions (Prumo)
# No Firebase v2, recomenda-se usar Google Cloud Secret Manager via:
#   firebase functions:secrets:set MP_ACCESS_TOKEN
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#
# Para testes locais via Firebase Emulator, preencha este arquivo e renomeie para .env.local:

# Mercado Pago (Pix Brasil)
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_WEBHOOK_SECRET=seu_webhook_secret_do_mercadopago

# Stripe (Global USD/EUR)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
