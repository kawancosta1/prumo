rules_version = '2';

// Regras do Firestore do Prumo. Cole tudo isto em: Console do Firebase → Firestore → Regras → Publicar.
// Ideia geral: cada pessoa só escreve no que é dela, e só amigos veem a vitrine e mandam coisas na caixa.
service cloud.firestore {
  match /databases/{database}/documents {

    // Logado e com email confirmado (conta Google já vem confirmada; conta com email confirma pelo link)
    function logado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function souEu(uid) {
      return logado() && request.auth.uid == uid;
    }
    // id da amizade: os dois uids em ordem, separados por _
    function parId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function caminhoAmizade(uid) {
      return /databases/$(database)/documents/amizades/$(parId(request.auth.uid, uid));
    }
    function somosAmigos(uid) {
      return logado() && exists(caminhoAmizade(uid)) && get(caminhoAmizade(uid)).data.estado == 'aceita';
    }

    // Rotina completa (tarefas, água, hábitos, diário, estante...): só o dono
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if souEu(uid);
    }

    // Texto opcional: se o campo existe, precisa ser texto de até max letras
    function textoOpcional(d, campo, max) {
      return !(campo in d) || (d[campo] is string && d[campo].size() <= max);
    }

    // Perfil público mínimo: só estes campos, com tipos e tamanhos (o app também limpa ao ler)
    function perfilValido(d) {
      return d.keys().hasOnly(['nome', 'usuario', 'codigo', 'persona', 'equip', 'atualizado'])
        && d.nome is string && d.nome.size() <= 60
        && d.usuario is string && d.usuario.size() <= 21
        && d.codigo is string && d.codigo.size() <= 12
        && d.persona is string && d.persona.size() <= 30
        && d.equip is map && d.equip.size() <= 20
        && d.atualizado is number;
    }

    // Vitrine: só os campos que o app publica (montarVitrine em js/amigos.js), com tipos e tamanhos
    function vitrineValida(d) {
      return d.keys().hasOnly(['nome', 'usuario', 'persona', 'equip', 'parceiro', 'tipo', 'mimo', 'visto',
          'nivel', 'sobre', 'visitas', 'layout', 'comunidades', 'top8', 'depoAceitos', 'status', 'ouvindo',
          'subnick', 'humor', 'agua', 'livroAtual', 'estante', 'fotolog', 'mixtape', 'ingressos', 'semana'])
        && d.nome is string && d.nome.size() <= 60
        && d.usuario is string && d.usuario.size() <= 21
        && d.persona is string && d.persona.size() <= 30
        && d.equip is map && d.equip.size() <= 20
        && d.visto is number && d.nivel is number && d.visitas is number
        && d.sobre is string && d.sobre.size() <= 400
        && d.status is string && d.status.size() <= 20
        && textoOpcional(d, 'ouvindo', 120)
        && textoOpcional(d, 'subnick', 120)
        && (!('agua' in d) || d.agua is number)
        && d.comunidades is list && d.comunidades.size() <= 50
        && d.top8 is list && d.top8.size() <= 8
        && d.depoAceitos is list && d.depoAceitos.size() <= 20
        && (!('fotolog' in d) || (d.fotolog is list && d.fotolog.size() <= 9))
        && (!('mixtape' in d) || (d.mixtape is map && d.mixtape.faixas is list && d.mixtape.faixas.size() <= 10))
        && (!('ingressos' in d) || (d.ingressos is map && d.ingressos.ultimos is list && d.ingressos.ultimos.size() <= 6))
        && (!('semana' in d) || d.semana is map);
    }

    // Perfil público mínimo (nome, @, código, mundo, roupas): para achar a pessoa e mandar pedido
    match /perfis/{uid} {
      allow read: if logado();
      allow create, update: if souEu(uid) && perfilValido(request.resource.data);
      allow delete: if souEu(uid);
    }

    // Vitrine: o que os amigos veem (humor, estante, Fotolog, status do MSN...)
    match /vitrines/{uid} {
      allow read: if souEu(uid) || somosAmigos(uid);
      allow create, update: if souEu(uid) && vitrineValida(request.resource.data);
      allow delete: if souEu(uid);
    }

    // Nome de usuário (@): cada @ aponta para um uid; só dá para pegar um @ livre, para você mesmo
    match /nomes/{nome} {
      allow read: if logado();
      allow create: if logado()
        && nome.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
      allow delete: if logado() && resource.data.uid == request.auth.uid;
    }

    // Amizades: pedido, aceite, bloqueio
    match /amizades/{id} {
      allow read: if logado() && request.auth.uid in resource.data.uids;
      allow create: if logado()
        && request.resource.data.de == request.auth.uid
        && request.resource.data.uids.size() == 2
        && request.auth.uid in request.resource.data.uids
        && id == parId(request.resource.data.uids[0], request.resource.data.uids[1])
        && (request.resource.data.estado == 'pendente'
            || (request.resource.data.estado == 'bloqueada' && request.resource.data.bloqueadoPor == request.auth.uid));
      allow update: if logado()
        && request.auth.uid in resource.data.uids
        && request.resource.data.uids == resource.data.uids
        && request.resource.data.de == resource.data.de
        && (
          // aceitar: só quem recebeu o pedido
          (resource.data.estado == 'pendente' && request.resource.data.estado == 'aceita' && request.auth.uid != resource.data.de)
          // bloquear: qualquer um dos dois, em nome de si mesmo
          || (request.resource.data.estado == 'bloqueada' && request.resource.data.bloqueadoPor == request.auth.uid && resource.data.estado != 'bloqueada')
        );
      // desfazer amizade ou recusar: qualquer um dos dois; desbloquear: só quem bloqueou
      allow delete: if logado()
        && request.auth.uid in resource.data.uids
        && (resource.data.estado != 'bloqueada' || resource.data.bloqueadoPor == request.auth.uid);
    }

    // Caixa de avisos: amigos mandam recados, depoimentos, mimos, pedidos de par e visitas; só o dono lê
    match /caixa/{uid}/itens/{item} {
      allow read, update, delete: if souEu(uid);
      allow create: if somosAmigos(uid)
        && request.resource.data.de == request.auth.uid
        && request.resource.data.tipo in ['recado', 'depoimento', 'mimo', 'par', 'visita', 'mixtape', 'livro', 'clube']
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 600
        && request.resource.data.visto == false;
    }

    // Clube do livro: só quem é membro vê. Só o dono adiciona gente; os outros só podem sair.
    function clubeValido(d) {
      return d.keys().hasOnly(['nome', 'livro', 'membros', 'dono', 'criado'])
        && d.nome is string && d.nome.size() <= 40
        && d.livro is map
        && d.membros is list && d.membros.size() <= 12
        && d.dono is string;
    }
    function membroDoClube(id) {
      return logado() && request.auth.uid in get(/databases/$(database)/documents/clubes/$(id)).data.membros;
    }
    match /clubes/{id} {
      allow read: if logado() && request.auth.uid in resource.data.membros;
      allow create: if logado()
        && request.resource.data.dono == request.auth.uid
        && request.auth.uid in request.resource.data.membros
        && clubeValido(request.resource.data);
      allow update: if logado()
        && request.auth.uid in resource.data.membros
        && request.resource.data.dono == resource.data.dono
        && clubeValido(request.resource.data)
        && (request.auth.uid == resource.data.dono
            // quem não é dono só pode sair (tirar a si mesmo), sem mexer no resto
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
                && request.resource.data.membros.toSet() == resource.data.membros.toSet().difference([request.auth.uid].toSet())));
      allow delete: if logado() && resource.data.dono == request.auth.uid;

      // progresso de cada membro no livro
      match /membros/{uid} {
        allow read: if membroDoClube(id);
        allow create, update: if souEu(uid) && membroDoClube(id)
          && request.resource.data.keys().hasOnly(['pagina', 'nome', 'em'])
          && request.resource.data.pagina is number
          && request.resource.data.nome is string && request.resource.data.nome.size() <= 60;
        allow delete: if souEu(uid);
      }
      // comentários por página (o app esconde os que estão depois da sua página)
      match /comentarios/{c} {
        allow read: if membroDoClube(id);
        allow create: if membroDoClube(id)
          && request.resource.data.keys().hasOnly(['de', 'deNome', 'pagina', 'texto', 'em'])
          && request.resource.data.de == request.auth.uid
          && request.resource.data.texto is string && request.resource.data.texto.size() <= 500
          && request.resource.data.pagina is number;
        allow delete: if logado() && resource.data.de == request.auth.uid;
      }
    }

    // Tudo o que não está listado acima fica fechado
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
